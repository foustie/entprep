# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI provider for runtime functions (ai-explain, ai-generate, ai-plan, ai-tutor).
# Default provider is "openrouter" (set in netlify/functions/utils/constants.mjs).
# Flip AI_PROVIDER to "anthropic" to roll back to Claude — no code change needed.
AI_PROVIDER=openrouter

# OpenRouter (default provider). Model override is optional (defaults to qwen/qwen3.7-plus).
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=qwen/qwen3.7-plus

# Anthropic (rollback provider — used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL_OVERRIDE=claude-sonnet-4-20250514

# Admin access (comma-separated emails)
ADMIN_EMAILS=admin@example.com
VITE_ADMIN_EMAILS=admin@example.com

# CORS (optional, defaults to https://entprep.org)
ALLOWED_ORIGIN=https://entprep.org

# Sentry (optional, error monitoring)
VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Push notifications (VAPID keys — generate with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=BPxxx...
VAPID_PRIVATE_KEY=xxx...
VAPID_SUBJECT=mailto:admin@example.com

# RevenueCat (native IAP — required for iOS/Android builds)
# Apple key from RevenueCat dashboard → Project → API keys → Apple App Store
# Must be passed at BUILD TIME (Vite inlines): VITE_RC_API_KEY_APPLE=appl_xxx npm run build
VITE_RC_API_KEY_APPLE=appl_xxx
VITE_RC_API_KEY_GOOGLE=goog_xxx
# Webhook secret for /api/revenuecat-webhook (set in RC dashboard → Integrations → Webhooks)
REVENUECAT_WEBHOOK_SECRET=whsec_xxx

# Lemon Squeezy (web payments)
LEMON_WEBHOOK_SECRET=whsec_xxx
LEMON_API_KEY=eyxxx...

# ── School white-label (optional; omit for retail ENTprep) ──────────────
# VITE_TENANT_MODE=school
# VITE_TENANT_ID=125
# Server-side tenant id read by netlify/functions/school-content.mjs (WS5 test
# import/assign). Separate from VITE_TENANT_ID because it is NOT inlined into
# the client bundle — set it in Netlify env for the school-125 site. Defaults
# to '125' if unset.
# TENANT_ID=125
# VITE_TENANT_NAME=Школа 125
# VITE_TENANT_SHORT_NAME=Школа 125
# VITE_TENANT_ACCENT=#FF5A36
# VITE_TENANT_LOGO=/favicon.svg
# VITE_APP_URL=https://school125.example.kz
# VITE_TENANT_HIDE_LANDING=true
# VITE_TENANT_HIDE_PAYWALL=true
# VITE_SCHOOL_SEATS_ALL=true
# VITE_SCHOOL_EMAIL_DOMAIN=
# VITE_AI_MONTHLY_CAP=300
# VITE_TENANT_WORDMARK_PRIMARY=Школа 125
# VITE_TENANT_WORDMARK_ACCENT=
# VITE_SOFT_PROCTOR=true
# Teacher allowlist (empty = any user can create classes). Mirror on server:
# TEACHER_EMAILS=teacher@school.kz
# VITE_TEACHER_EMAILS=teacher@school.kz
