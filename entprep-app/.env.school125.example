# School-125 white-label build (Netlify site A — same Supabase project)
# Copy to .env for local school preview. Do NOT use on retail entprep.org.
# Migrations + Netlify deploy: later (not yet).

VITE_TENANT_MODE=school
VITE_TENANT_ID=125
VITE_TENANT_NAME=Школа 125
VITE_TENANT_SHORT_NAME=Школа 125
# Crest palette: gold accent + navy secondary (logo)
VITE_TENANT_ACCENT=#F5C518
VITE_TENANT_LOGO=/tenant/125-crest.png
VITE_TENANT_FAVICON=/tenant/125-favicon.png
VITE_APP_URL=
VITE_TENANT_HIDE_LANDING=true
VITE_TENANT_HIDE_PAYWALL=true
VITE_SCHOOL_SEATS_ALL=true
# Optional: restrict seats to email domain instead of seats-all
# VITE_SCHOOL_EMAIL_DOMAIN=school125.kz
# VITE_SCHOOL_SEATS_ALL=false
VITE_AI_MONTHLY_CAP=300
VITE_SOFT_PROCTOR=true
VITE_HARD_PROCTOR=true
VITE_TENANT_WORDMARK_PRIMARY=Школа
VITE_TENANT_WORDMARK_ACCENT= 125

# Server (Netlify functions) — when deploying later
TENANT_ID=125
# TEACHER_EMAILS=teacher1@school.kz,teacher2@school.kz
# VITE_TEACHER_EMAILS=teacher1@school.kz,teacher2@school.kz

# Same Supabase as retail (tenant_id isolates new tables) — wire when ready
# VITE_SUPABASE_URL=...
# VITE_SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_KEY=...
